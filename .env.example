# Copy to .env.local and fill in. Never commit real values.
#
# Local development: run `pnpm db:start` (needs Docker), then copy the values printed by
# `pnpm exec supabase status`.
# Dev and production use SEPARATE Supabase projects. Never point dev at prod.

# Supabase (public: inlined into the browser bundle)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key. SERVER ONLY: bypasses RLS. Never prefix with NEXT_PUBLIC_ or import into client code.
SUPABASE_SECRET_KEY=

# HMAC secret for hashing check-in client IPs (rate limiting). SERVER ONLY. 32+ random chars: `openssl rand -base64 32`
CHECKIN_IP_HMAC_SECRET=

# Sentry (production only; leave empty in dev, the SDK is disabled outside production)
NEXT_PUBLIC_SENTRY_DSN=
# Build-time source map upload. Set in the hosting provider / CI, not locally.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
